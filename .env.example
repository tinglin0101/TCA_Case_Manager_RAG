# 複製這個檔案為 .env 並依需求調整：  cp .env.example .env

# ─────────────────────────────────────────────
# LLM 供應商：local（本地端，預設）或 openai（雲端）
# ─────────────────────────────────────────────
LLM_PROVIDER=local

# ---- 本地端（LLM_PROVIDER=local）----
# 用 Ollama 等「OpenAI 相容」伺服器。資料不出機房、免 API 金鑰。
# 先安裝 Ollama 並下載模型：  ollama pull qwen2.5:14b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
#   硬體更好可換更強的模型，例如：LLM_MODEL=qwen2.5:32b
#   本地端不驗證金鑰，這行留著即可（隨便一個非空字串）
OPENAI_API_KEY=ollama

# ---- 雲端（把上面改成 LLM_PROVIDER=openai 時才需要）----
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-你的金鑰

# 生成溫度（衛教問答建議偏低、較穩定）
LLM_TEMPERATURE=0.2

# ─────────────────────────────────────────────
# Embedding（檢索用，永遠在本地跑，免 API）
# 多語系、支援繁體中文；第一次執行會自動下載約 ~470MB
# ─────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 每次檢索取回幾段最相關內容
TOP_K=4
